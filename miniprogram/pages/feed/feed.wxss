.cat-scroll {
  white-space: nowrap;
  width: 100%;
}
.cat-scroll .chip {
  display: inline-flex;
  flex-shrink: 0;
}
.detail-cover {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto;
  border: 4rpx solid var(--ink);
  border-radius: 36rpx;
  background: linear-gradient(135deg, #FFEFC7, #FFD8E4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 110rpx;
  overflow: hidden;
  box-shadow: 6rpx 8rpx 0 rgba(59,43,38,.14);
}
