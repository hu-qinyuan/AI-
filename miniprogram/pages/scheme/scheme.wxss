.effect-card {
  height: 300rpx;
  border: 4rpx solid var(--ink);
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFE9A8, #FFC7E0 55%, #C7F5DF);
  box-shadow: 6rpx 8rpx 0 rgba(59,43,38,.14);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.effect-image { width: 100%; height: 100%; }
.effect-emoji { font-size: 120rpx; animation: bob 3.2s ease-in-out infinite; }
.effect-label { font-size: 22rpx; font-weight: 800; color: #7A5B4B; margin-top: 8rpx; }
.step-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.step-num {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--yellow);
  border: 3rpx solid var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}
.step-text {
  flex: 1;
  font-size: 26rpx;
  padding-top: 4rpx;
}
